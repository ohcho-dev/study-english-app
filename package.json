{
  "name": "study-english",
  "private": true,
  "scripts": {
    "start": "pnpm --filter mobile start -- --clear",
    "start:admin": "pnpm --filter admin dev",
    "start:admin:https": "pnpm --filter admin dev:https",
    "start:admin:share": "bash scripts/start-admin-shared.sh",
    "start:app": "pnpm --filter mobile start -- --clear",
    "ios": "pnpm --filter mobile run:ios",
    "android": "pnpm --filter mobile run:android",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.8.1",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}