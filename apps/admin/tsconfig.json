{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/shared/*": [
        "./src/(fsd)/shared/*"
      ],
      "@/shared": [
        "./src/(fsd)/shared"
      ],
      "@/entities/*": [
        "./src/(fsd)/entities/*"
      ],
      "@/entities": [
        "./src/(fsd)/entities"
      ],
      "@/features/*": [
        "./src/(fsd)/features/*"
      ],
      "@/features": [
        "./src/(fsd)/features"
      ],
      "@/widgets/*": [
        "./src/(fsd)/widgets/*"
      ],
      "@/widgets": [
        "./src/(fsd)/widgets"
      ],
      "@/pages/*": [
        "./src/(fsd)/pages/*"
      ],
      "@/pages": [
        "./src/(fsd)/pages"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules"
  ]
}