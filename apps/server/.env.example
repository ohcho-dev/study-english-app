# Application
APP_NAME="Study English API"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/studyenglish

# Redis
REDIS_URL=redis://localhost:6379

# JWT
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth - Kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# OAuth - Naver
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI - Google Gemini
GOOGLE_AI_API_KEY=

# AI - Google Cloud STT/TTS
GOOGLE_CLOUD_STT_TTS_API_KEY=

# Google Cloud Project ID (V2 STT API용 - chirp_2, chirp_3)
GOOGLE_CLOUD_PROJECT=

# AI - OpenAI (optional)
OPENAI_API_KEY=

# Storage (GCS) — 비어있으면 로컬 디스크 저장
GCS_BUCKET_NAME=
