{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/lib": [
        "./lib"
      ],
      "@/lib/*": [
        "./lib/*"
      ],
      "@/shared": [
        "./shared"
      ],
      "@/shared/*": [
        "./shared/*"
      ],
      "@/entities": [
        "./entities"
      ],
      "@/entities/*": [
        "./entities/*"
      ],
      "@/features": [
        "./features"
      ],
      "@/features/*": [
        "./features/*"
      ],
      "@/widgets": [
        "./widgets"
      ],
      "@/widgets/*": [
        "./widgets/*"
      ],
      "@/pages": [
        "./pages"
      ],
      "@/pages/*": [
        "./pages/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}